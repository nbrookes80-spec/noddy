<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diagnostic Trouble Codes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Standard SAE Mode 03 read / Mode 04 clear - works on the public OBD2 port on this ECU. Clearing also resets the readiness monitors, so re-clear only when you mean to."
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/txt_dtc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Idle"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_read_dtc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Read Codes"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginEnd="4dp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_dtc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear Codes"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginStart="4dp"
            android:textColor="@color/write_action_warning"
            app:strokeColor="@color/write_action_warning"
            app:strokeWidth="2dp"
            app:backgroundTint="@color/carbon_black"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txt_dtc_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="#00FF66"
            android:padding="12dp"
            android:text="No codes read yet. Tap Read Codes." />

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_export_dtc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export Results (CSV)"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="8dp" />

</LinearLayout>
